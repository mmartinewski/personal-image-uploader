{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PIU",
  "version": "1.4.0",
  "identifier": "com.mmartinewski.piu",
  "build": {
    "frontendDist": "../frontend/dist/frontend/browser",
    "beforeDevCommand": "npm run tauri:before-dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/piu-backend"
    ],
    "resources": {
      "binaries/piu-backend-assets/": "piu-backend-assets/"
    }
  }
}
