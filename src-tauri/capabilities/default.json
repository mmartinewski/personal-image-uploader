{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "PIU desktop tray permissions",
  "windows": [],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "node",
          "cmd": "node",
          "args": true
        },
        {
          "name": "binaries/piu-backend",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        {
          "name": "node",
          "cmd": "node"
        },
        {
          "name": "binaries/piu-backend",
          "sidecar": true
        }
      ]
    }
  ]
}
