{
  "name": "personal-image-uploader",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:go": "node scripts/build-go.cjs",
    "postinstall": "npm run build:go",
    "db:migrate": "npm --workspace backend run db:migrate",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run start",
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "start": "npm --workspace backend run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
